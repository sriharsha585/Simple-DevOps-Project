FROM rockylinux:8
RUN yum update -y && \
    yum install -y java-11-openjdk-devel && \
    yum clean all
RUN mkdir /opt/tomcat
WORKDIR /opt/tomcat
ADD https://dlcdn.apache.org/tomcat/tomcat-10/v10.1.49/bin/apache-tomcat-10.1.49.tar.gz .
RUN tar -xvzf apache-tomcat-10.1.49.tar.gz
RUN mv apache-tomcat-10.1.49/* /opt/tomcat
EXPOSE 8080
CMD ["/opt/tomcat/bin/catalina.sh", "run"]


